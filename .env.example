# ==============================================================================
# PhD Position Hunter - Environment Configuration
# Copy this file to .env and fill in your credentials:
# cp .env.example .env
# ==============================================================================

# --- TELEGRAM NOTIFICATION SETTINGS ---
# Set to 'true' to enable Telegram alerts
TELEGRAM_ENABLED=true

# Get your Bot Token from @BotFather on Telegram (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Get your Chat ID from @userinfobot or @GetMyIDBot (e.g. 987654321 or channel @your_channel)
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"


# --- EMAIL NOTIFICATION SETTINGS (SMTP) ---
# Set to 'true' to enable Email alerts
EMAIL_ENABLED=false

# SMTP Server details (e.g., smtp.gmail.com for Gmail, smtp.office365.com for Outlook)
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USE_TLS=true

# Your email address (for Gmail, use your full @gmail.com address)
SMTP_SENDER_EMAIL="your_email@gmail.com"

# For Gmail, generate an "App Password" at: https://myaccount.google.com/apppasswords
SMTP_PASSWORD="your_16_character_app_password"

# Destination email where daily digests will be delivered
EMAIL_RECIPIENT="recipient_email@example.com"


# --- SCRAPER & SCHEDULER SETTINGS ---
# Daily execution time in 24-hour format (e.g. 08:00 for 8:00 AM)
SCHEDULE_TIME="08:00"

# Timezone (e.g. UTC, Europe/Zurich, Europe/London, Asia/Singapore)
TIMEZONE="UTC"

# Run an immediate search upon startup before waiting for schedule (true/false)
RUN_ON_STARTUP=true

# Request delay range in seconds (randomized to prevent rate-limiting)
MIN_REQUEST_DELAY=2.5
MAX_REQUEST_DELAY=6.0

# Database file for position deduplication
DB_PATH="phd_positions.db"
